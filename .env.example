DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clientdesk
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Development prints email links in the server terminal. Production requires SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ClientDesk <hello@example.com>

# Optional Google sign-in. Redirect URI: /api/auth/callback/google on your app domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Demo seeding requires a password of at least 12 characters.
DEMO_PASSWORD=
